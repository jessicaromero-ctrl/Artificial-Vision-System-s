"""
Experimento: detección de esquinas con el detector de Harris.

Barrido del umbral absoluto δ sobre la función de respuesta de esquina V,
aplicado a un conjunto de imágenes en escala de grises.

Pipeline (técnica de la clase):
    1. Filtro de media 3x3 (núcleo 1/9)
    2. Gradientes Sobel 3x3 (gx, gy)
    3. Componentes de la matriz de estructura: Ixx, Iyy, Ixy
    4. Suavizado gaussiano 3x3 de cada componente
    5. Respuesta de Harris: V = (A*B - C^2) - alpha*(A + B)^2
    6. Supresión de no máximos (dilatación 3x3) y umbral δ

δ NO es una desviación estándar ni un parámetro del suavizado.
Es un umbral absoluto: solo se conservan máximos locales con V >= δ.

Requisitos:
    pip install numpy opencv-python matplotlib
"""

import argparse
import os
from dataclasses import dataclass

import cv2
import matplotlib.pyplot as plt
import numpy as np


ALPHA_HARRIS = 0.04
RANGO_DELTA = (900, 1_000_000)
NUM_DELTAS_DEFECTO = 10
TAMANO_KERNEL_DILATACION = 5

IMAGENES_BASE = [
    ("Cuadrado", "Cuadrado.jpeg"),
    ("Cuadrícula", "Cuadrícula.jpeg"),
    ("Estrella", "Estrella.jpeg"),
    ("Figuras", "Figuras.jpeg"),
    ("Lena_Gray", "Lena_Gray.png"),
    ("Libros", "Libros.jpeg"),
]

IMAGENES_EXTRA = [
    ("Calico", os.path.join("..", "tarea2", "calico.jpeg")),
    ("Gato_Gris", os.path.join("..", "gato-gris.jpg")),
    ("Gato_Smocking", os.path.join("..", "gato-smocking.jpg")),
    ("Paisaje", os.path.join("..", "paisaje.png")),
]


def cargar_imagen_gris(ruta):
    """Carga en escala de grises; np.fromfile evita problemas con acentos en Windows."""
    if not os.path.isfile(ruta):
        raise FileNotFoundError(f"No se localizó el archivo: {ruta}")
    datos = np.fromfile(ruta, dtype=np.uint8)
    img = cv2.imdecode(datos, cv2.IMREAD_GRAYSCALE)
    if img is None:
        raise ValueError(f"No fue posible decodificar la imagen: {ruta}")
    return img


KERNEL_MEDIA_3X3 = np.ones((3, 3), dtype=np.float32) / 9.0

KERNEL_SOBEL_X = np.array([
    [-1, 0, 1],
    [-2, 0, 2],
    [-1, 0, 1],
], dtype=np.float32)

KERNEL_SOBEL_Y = np.array([
    [-1, -2, -1],
    [ 0,  0,  0],
    [ 1,  2,  1],
], dtype=np.float32)


def _anular_borde(matriz):
    """Pone a cero el borde de 1 píxel de una matriz 2D (in-place)."""
    matriz[0, :] = 0
    matriz[-1, :] = 0
    matriz[:, 0] = 0
    matriz[:, -1] = 0
    return matriz


def filtrar_media(img):
    """Paso 1. Filtro de media 3x3 con redondeo a uint8 y borde a cero."""
    suavizada = cv2.filter2D(
        img.astype(np.float32), -1, KERNEL_MEDIA_3X3,
        borderType=cv2.BORDER_CONSTANT,
    )
    suavizada = np.round(suavizada).astype(np.uint8)
    return _anular_borde(suavizada)


def gradientes_sobel(img):
    """Paso 2. Gradientes Sobel 3x3 en x e y, con borde a cero."""
    entrada = img.astype(np.float32)
    gx = cv2.filter2D(entrada, -1, KERNEL_SOBEL_X, borderType=cv2.BORDER_CONSTANT)
    gy = cv2.filter2D(entrada, -1, KERNEL_SOBEL_Y, borderType=cv2.BORDER_CONSTANT)
    return _anular_borde(gx), _anular_borde(gy)


def matriz_estructura(gx, gy):
    """Paso 3. Componentes Ixx, Iyy, Ixy de la matriz de estructura."""
    return gx * gx, gy * gy, gx * gy


def suavizar_gaussiano(componente):
    """Paso 4. Suavizado gaussiano con núcleo 3x3 (sigma = 0, lo calcula OpenCV)."""
    return cv2.GaussianBlur(componente, (3, 3), 0)


def respuesta_harris(img, alpha=ALPHA_HARRIS):
    """Pasos 1 a 5. Devuelve V = (A*B - C^2) - alpha*(A + B)^2."""
    suavizada = filtrar_media(img)
    gx, gy = gradientes_sobel(suavizada)
    ixx, iyy, ixy = matriz_estructura(gx, gy)

    A = suavizar_gaussiano(ixx)
    B = suavizar_gaussiano(iyy)
    C = suavizar_gaussiano(ixy)

    return (A * B - C ** 2) - alpha * (A + B) ** 2


def supresion_no_maximos(V):
    """Paso 6a. Dilatación 3x3 de V para comparar máximos locales."""
    return cv2.dilate(V, np.ones((3, 3), np.uint8))


def detectar_esquinas(V, V_max, delta):
    """
    Paso 6b. Umbral absoluto δ sobre V.

    Devuelve:
        puntual      : máscara de máximos locales con V >= δ
        dilatada     : máscara puntual dilatada con kernel 5x5
        num_esquinas : cantidad de esquinas puntuales
    """
    puntual = ((V == V_max) & (V >= delta)).astype(np.uint8)
    kernel = np.ones((TAMANO_KERNEL_DILATACION, TAMANO_KERNEL_DILATACION), np.uint8)
    dilatada = cv2.dilate(puntual, kernel)
    return puntual, dilatada, int(puntual.sum())


COLOR_MARCA_RGB = (255, 30, 30)


def superponer_mascara(img_gris, mascara, grosor_punto=1):
    """Pinta de rojo los píxeles de la máscara sobre la imagen en gris (RGB)."""
    salida = cv2.cvtColor(img_gris, cv2.COLOR_GRAY2RGB)
    if grosor_punto > 1:
        mascara = cv2.dilate(mascara, np.ones((grosor_punto, grosor_punto), np.uint8))
    salida[mascara > 0] = COLOR_MARCA_RGB
    return salida


def mascara_binaria(mascara):
    """Convierte una máscara 0/1 en imagen 0/255."""
    return mascara * 255


def generar_vista(img_gris, mascara, modo, tipo):
    """
    modo: 'overlay' (superposición) o 'binary' (máscara pura)
    tipo: 'puntual' (se engrosa 2x2 solo para visibilidad) o 'dilatada'
    """
    if modo == "binary":
        return mascara_binaria(mascara)
    grosor = 2 if tipo == "puntual" else 1
    return superponer_mascara(img_gris, mascara, grosor_punto=grosor)


@dataclass
class ResultadoImagen:
    nombre: str
    shape: tuple
    conteos: list
    vistas: dict  # (tipo, modo) -> lista de imágenes por δ


def generar_deltas(num, escala):
    """Genera num valores de δ en RANGO_DELTA con escala 'log' o 'linear'."""
    inicio, fin = RANGO_DELTA
    if escala == "log":
        valores = np.geomspace(inicio, fin, num)
    else:
        valores = np.linspace(inicio, fin, num)
    return valores.astype(int)


def procesar_imagen(nombre, ruta, deltas):
    """Ejecuta Harris sobre una imagen para todos los valores de δ."""
    img = cargar_imagen_gris(ruta)
    V = respuesta_harris(img)
    V_max = supresion_no_maximos(V)

    vistas = {
        ("puntual", "overlay"): [],
        ("puntual", "binary"): [],
        ("dilatada", "overlay"): [],
        ("dilatada", "binary"): [],
    }
    conteos = []

    for delta in deltas:
        puntual, dilatada, n = detectar_esquinas(V, V_max, delta)
        conteos.append(n)
        vistas[("puntual", "overlay")].append(generar_vista(img, puntual, "overlay", "puntual"))
        vistas[("puntual", "binary")].append(generar_vista(img, puntual, "binary", "puntual"))
        vistas[("dilatada", "overlay")].append(generar_vista(img, dilatada, "overlay", "dilatada"))
        vistas[("dilatada", "binary")].append(generar_vista(img, dilatada, "binary", "dilatada"))

    return ResultadoImagen(nombre=nombre, shape=img.shape, conteos=conteos, vistas=vistas)


def resolver_imagenes(directorio_base, incluir_extra):
    """Arma la lista (nombre, ruta) de imágenes."""
    lista = [(n, os.path.join(directorio_base, f)) for n, f in IMAGENES_BASE]
    if incluir_extra:
        for nombre, ruta_rel in IMAGENES_EXTRA:
            ruta = os.path.normpath(os.path.join(directorio_base, ruta_rel))
            if os.path.isfile(ruta):
                lista.append((nombre, ruta))
    return lista


def formatear_delta(delta):
    return f"{delta:,}".replace(",", " ")


def tabla_markdown(resultados, deltas):
    """Tabla de conteos en Markdown."""
    encabezado = "| Imagen | " + " | ".join(f"δ={formatear_delta(d)}" for d in deltas) + " |"
    separador = "| :--- | " + " | ".join([":---:"] * len(deltas)) + " |"
    filas = [
        f"| **{r.nombre}** | " + " | ".join(f"{c:,}" for c in r.conteos) + " |"
        for r in resultados
    ]
    return "\n".join([encabezado, separador, *filas])


def graficar_tabla(resultados, deltas, tipo, modo, ruta_salida):
    """Figura con filas = imágenes y columnas = valores de δ."""
    filas, columnas = len(resultados), len(deltas)
    fig, ejes = plt.subplots(filas, columnas, figsize=(26, 16), dpi=150, squeeze=False)

    etiqueta_tipo = "Esquinas dilatadas (5x5)" if tipo == "dilatada" else "Esquinas puntuales"
    etiqueta_modo = "superpuestas en la imagen" if modo == "overlay" else "máscara binaria"
    fig.suptitle(
        "Detector de Harris: barrido del umbral δ sobre la respuesta V\n"
        f"{etiqueta_tipo}, {etiqueta_modo}",
        fontsize=15, fontweight="bold",
    )

    for i, res in enumerate(resultados):
        for j, delta in enumerate(deltas):
            ax = ejes[i, j]
            vista = res.vistas[(tipo, modo)][j]
            if modo == "binary":
                ax.imshow(vista, cmap="gray", vmin=0, vmax=255)
            else:
                ax.imshow(vista)
            ax.set_xticks([])
            ax.set_yticks([])

            if i == 0:
                ax.set_title(f"δ = {formatear_delta(delta)}", fontsize=9.5, fontweight="bold")
            if j == 0:
                alto, ancho = res.shape
                ax.set_ylabel(f"{res.nombre}\n({ancho}x{alto})",
                              fontsize=9.5, fontweight="bold", rotation=0,
                              labelpad=45, va="center")

            ax.text(0.96, 0.05, f"N={res.conteos[j]:,}", transform=ax.transAxes,
                    fontsize=8, color="white", fontweight="bold", ha="right", va="bottom",
                    bbox=dict(boxstyle="round,pad=0.2", facecolor="black",
                              alpha=0.7, edgecolor="none"))

    plt.tight_layout(rect=[0.05, 0.02, 0.99, 0.95])
    fig.savefig(ruta_salida, bbox_inches="tight")
    plt.close(fig)
    print(f"[OK] Figura guardada: {ruta_salida}")


def construir_parser():
    parser = argparse.ArgumentParser(
        description="Barrido del umbral δ del detector de Harris sobre un conjunto de imágenes."
    )
    parser.add_argument("--num-deltas", type=int, default=NUM_DELTAS_DEFECTO,
                        help="Número de valores de δ en el rango (por defecto: 10).")
    parser.add_argument("--escala", choices=["log", "linear"], default="log",
                        help="Distribución de los valores de δ (por defecto: log).")
    parser.add_argument("--incluir-extra", action="store_true",
                        help="Incluye imágenes adicionales si existen en el directorio superior.")
    parser.add_argument("--salida", default=None,
                        help="Directorio de salida (por defecto: resultados_grid junto al script).")
    parser.add_argument("--mostrar", action="store_true",
                        help="Muestra las figuras en ventana interactiva al terminar.")
    return parser


def main():
    args = construir_parser().parse_args()

    directorio_base = os.path.dirname(os.path.abspath(__file__))
    directorio_salida = args.salida or os.path.join(directorio_base, "resultados_grid")
    os.makedirs(directorio_salida, exist_ok=True)

    deltas = generar_deltas(args.num_deltas, args.escala)
    imagenes = resolver_imagenes(directorio_base, args.incluir_extra)

    print(f"[*] Imágenes: {len(imagenes)}")
    print(f"[*] Valores de δ ({args.escala}, N={args.num_deltas}): {list(deltas)}")

    resultados = []
    for nombre, ruta in imagenes:
        print(f"[+] Procesando {nombre} ({os.path.basename(ruta)})")
        resultados.append(procesar_imagen(nombre, ruta, deltas))

    md = tabla_markdown(resultados, deltas)
    print("\n" + md + "\n")

    ruta_md = os.path.join(directorio_salida, f"tabla_conteo_{args.num_deltas}_deltas_{args.escala}.md")
    with open(ruta_md, "w", encoding="utf-8") as f:
        f.write(f"# Conteo de esquinas por umbral δ ({args.num_deltas} valores, escala {args.escala})\n\n")
        f.write(md + "\n")
    print(f"[OK] Tabla guardada: {ruta_md}")

    combinaciones = [
        ("puntual", "overlay"),
        ("dilatada", "overlay"),
        ("puntual", "binary"),
        ("dilatada", "binary"),
    ]
    for tipo, modo in combinaciones:
        nombre_archivo = f"plot_{tipo}_{modo}_{args.escala}.png"
        graficar_tabla(resultados, deltas, tipo, modo,
                       os.path.join(directorio_salida, nombre_archivo))

    if args.mostrar:
        plt.show()

    print("\n[PROCESO COMPLETADO]")


if __name__ == "__main__":
    main()
